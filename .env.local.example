# Free project ID from https://cloud.reown.com — required only for the
# WalletConnect connector (QR-code / mobile wallet connections). Without it,
# WalletConnect is simply omitted from the wallet picker; Base Account and
# any installed browser extension wallet (MetaMask, Rabby, etc.) still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Paymaster & Bundler URL (e.g. from Coinbase Developer Platform:
# https://portal.cdp.coinbase.com) — required only to sponsor gas on deposits.
# Without it, deposits work exactly as before (the depositor pays their own
# gas). Even when set, sponsorship only happens for wallets that support the
# EIP-5792 paymasterService capability (e.g. Base Account / Coinbase Wallet);
# other wallets fall back to normal signing. Any spending policy — first
# deposit only, per-address caps, daily limits — is configured on the
# provider's own dashboard, not in this app.
NEXT_PUBLIC_PAYMASTER_URL=

# Base RPC endpoint. Without it, this app uses PublicNode's free anonymous
# endpoint (https://base-rpc.publicnode.com), which works fine for light use
# but has a request-volume ceiling — hit in real testing when background APY
# polling and a transaction's own receipt-polling ran concurrently against it,
# surfacing as a misleading "Archive requests require a personal token" error
# even on plain, non-archival reads. A free personal token from
# https://www.allnodes.com/publicnode raises that ceiling; set the full URL
# it gives you here (e.g. https://base-rpc.publicnode.com/<token>).
NEXT_PUBLIC_BASE_RPC_URL=
